# ==============================================================================
# JARVIS CORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholder values with actual secrets.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- Microsoft Azure AI Foundry (OpenAI) ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_HEAVY=gpt-4o
AZURE_DEPLOYMENT_SPEED=gpt-4.1-mini

# --- IPC EventBus & Telemetry ---
EVENT_BUS_HOST=127.0.0.1
EVENT_BUS_PORT=49152
MAX_DISPATCH_LATENCY_MS=250

# --- WebHUD & FastAPI Gateway ---
WEBHUD_HOST=0.0.0.0
WEBHUD_PORT=8080
WEBHUD_CORS_ORIGINS="*"

# --- Security & AegisCore (Zero-Trust) ---
AEGIS_ZERO_TRUST_MODE=STRICT
SANDBOX_TIMEOUT_SEC=20.0
QUOTA_WARDEN_DAILY_LIMIT=500

# --- Storage, Memory & RAG Paths ---
CHROMA_DB_PATH=./memory/storage/chroma_vault
SQLITE_WAL_PATH=./memory/wings/
EVOLUTION_VAULT_PATH=./evolution/
